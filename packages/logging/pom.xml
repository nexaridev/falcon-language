<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.nexaridev</groupId>
  <artifactId>logging</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Falcon logging module</name>
  <description>Timestamped console logging helpers for Falcon.</description>
  <url>https://github.com/nexaridev/falcon-language/tree/main/packages/logging</url>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/nexaridev/falcon-language</url>
    </repository>
  </distributionManagement>
  <build>
    <resources>
      <resource>
        <directory>.</directory>
        <includes><include>module.json</include><include>__init__.fc</include><include>README.md</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../..</directory>
        <includes><include>LICENSE</include><include>NOTICE</include></includes>
      </resource>
    </resources>
  </build>
</project>
