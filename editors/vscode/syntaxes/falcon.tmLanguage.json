{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Falcon",
  "scopeName": "source.falcon",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "name": "storage.type.function.falcon", "match": "\\bfunc\\b" },
    { "name": "storage.modifier.falcon", "match": "\\b(var|fix)\\b" },
    { "name": "keyword.control.import.falcon", "match": "\\b(use|as)\\b" },
    { "name": "entity.name.namespace.falcon", "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\.[\\p{L}_])" },
    { "name": "keyword.control.falcon", "match": "\\b(if|elseif|when|else|while|each|in|give)\\b" },
    { "name": "storage.type.falcon", "match": "\\b(int|float|number|bool|string|void|any|list|map)\\b" },
    { "name": "constant.language.falcon", "match": "\\b(true|false|null)\\b" },
    { "name": "support.function.falcon", "match": "\\bsay(?=\\s*\\()" },
    { "name": "entity.name.function.falcon", "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()" },
    { "name": "constant.numeric.falcon", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" },
    { "name": "keyword.operator.falcon", "match": "->|\\.\\.|==|!=|<=|>=|&&|\\|\\||[+*/%!=<>-]" },
    { "name": "punctuation.separator.falcon", "match": "[.,:;]" },
    { "name": "punctuation.section.falcon", "match": "[{}()\\[\\]]" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.falcon", "begin": "//", "end": "$" },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.falcon",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block-comment" }]
    },
    "strings": {
      "name": "string.quoted.double.falcon",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.falcon", "match": "\\\\[nrt\"\\\\]" },
        { "name": "invalid.illegal.escape.falcon", "match": "\\\\." }
      ]
    }
  }
}
