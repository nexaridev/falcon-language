{
  "Import module": {
    "prefix": "use",
    "body": [
      "use ${1:math}"
    ],
    "description": "Import a sibling .fc module"
  },
  "Import relative path": {
    "prefix": "usepath",
    "body": [
      "use \"${1:lib/math.fc}\" as ${2:math}"
    ],
    "description": "Import a .fc file under a local alias"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "func main() {",
      "    $0",
      "}"
    ],
    "description": "Falcon entry point"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:value}: ${3:int}) -> ${4:int} {",
      "    give $0",
      "}"
    ],
    "description": "Function with an explicit return type"
  },
  "Each loop": {
    "prefix": "each",
    "body": [
      "each (${1:i} in ${2:0}..${3:10}) {",
      "    $0",
      "}"
    ],
    "description": "Iterate over an exclusive-end integer range"
  },
  "When": {
    "prefix": "when",
    "body": [
      "when (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Conditional block"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Conditional block"
  },
  "Else if": {
    "prefix": "elseif",
    "body": [
      "elseif (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Additional conditional branch"
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Conditional with fallback"
  }
}
