func main()
{
    var first = 10; var second = 20
    fix total = first +
        second +
        30

    say(
        "Total:",
        total
    )

    if (total == 60) {
        say("Semicolons are optional!")
    }
    elseif (total > 60) {
        say("Larger than expected")
    }
    else {
        say("Smaller than expected")
    }
}
